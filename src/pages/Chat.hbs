<div class="chats-container">
  <aside class="chats-controls">
    {{> button-item text="Профиль >" id="profile-settings" class="chats-controls__button"}}
    <search class="chats-search">
      <form class="chats-search__form">
        {{> input-item id="search" type="search" placeholder="Поиск" class="chats-search__input"}}
      </form>
    </search>
    <ul class="chats-controls__chats-list backdrop">
      {{#each chats}}
        <li class="chats-controls__chats-item">{{> chat-item}}</li>
      {{/each}}
    </ul> 
  </aside>
  <main class="chat-view">
    {{> subtitle-item class="chat-view" text="Выберите адресата, чтобы отправить ему письмо"}}
  </main>
</div>