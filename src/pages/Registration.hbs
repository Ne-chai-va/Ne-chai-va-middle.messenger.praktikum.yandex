<main class="register-page backdrop">
  {{> main-title-item text="Регистрация" class="register-page__title"}}
  <form id="register-page__form" class="register-page__form">
    {{> input-item id="first_name" type="text" placeholder="Имя" class="register-page__input"}}
    {{> input-item id="second_name" type="text" placeholder="Фамилия" class="register-page__input"}}
    {{> input-item id="email" type="email" placeholder="E-mail" class="register-page__input"}}
    {{> input-item id="phone" type="tel" placeholder="Номер телефона" class="register-page__input"}}
    {{> input-item id="login" type="text" placeholder="Логин" class="register-page__input"}}
    {{> input-item id="password" type="text" placeholder="Пароль" class="register-page__input"}}
    {{> input-item id="passwordCheck" type="text" placeholder="Пароль ещё раз" class="register-page__input"}}
  </form>
  {{> button-item text="Записаться" type="submit" id="sign-up" class="register-page__button"}}
  {{> button-item text="Войти" id="sign-in" class="register-page__button inactive"}}
</main>