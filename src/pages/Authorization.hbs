<main class="auth-page">
  <h1 class="auth-page__title">Вход</h1>
  <form id="auth-page__form">
    {{> input-item id="login" type="text" placeholder="Логин" class="auth-page"}}
    {{> input-item id="password" type="text" placeholder="Пароль" class="auth-page"}}
  </form>
  {{> button-item text="Войти" id="sign-in" class="auth-page"}}
  {{> button-item text="Зарегистрироваться" id="sign-up" class="auth-page"}}
</main>