<div class="chat-item" data-id="{{id}}">
  <div class="chat-item__block">
    <div class="chat-item__avatar">
      <img src="{{avatarUrl}}" alt="avatar" class="chat-item__image" />
    </div>
    <div class="chat-item__text">
      <div class="chat-item__name">
        <div class="chat-item__title">
          {{title}}
        </div>
      </div>
      {{#with lastMessage}}
        <div class="chat-item__message">
          {{{text}}}
        </div>
      {{/with}}
    </div>
    <div class="chat-item__data">
      {{#with lastMessage}}
        <time class="chat-item__date" datetime="{{time}}">
          {{time}}
        </time>
      {{/with}}
      {{#if unreadCount}}
        <span class="chat-item__badge">{{unreadCount}}</span>
      {{/if}}
    </div>
  </div>
  <hr class="chat-item__divider" />
</div>